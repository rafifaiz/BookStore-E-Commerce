### =======================================================
### TEST TUGAS PRAKTIKUM MANDIRI MINGGU KE-2 (ASSIGNMENT 2)
### E-Library API: Custom Providers & Discounts Engine
### =======================================================

@baseUrl = http://localhost:3000

### -------------------------------------------------------
### 1. PENGUJIAN CUSTOM FACTORY PROVIDER: DISCOUNT_ENGINE
### -------------------------------------------------------

### 1.1. Hitung Harga Sewa Diskon Mahasiswa (Diskon 30%)
GET {{baseUrl}}/books/1/calculate-price?memberType=mahasiswa

### 1.2. Hitung Harga Sewa Diskon Dosen (Diskon 50%)
GET {{baseUrl}}/books/1/calculate-price?memberType=dosen

### 1.3. Hitung Harga Sewa Kategori Umum (Diskon 0%)
GET {{baseUrl}}/books/1/calculate-price?memberType=umum

### 1.4. Hitung Harga Sewa Buku ID #2 untuk Dosen
GET {{baseUrl}}/books/2/calculate-price?memberType=dosen


### -------------------------------------------------------
### 2. PENGUJIAN CUSTOM FACTORY PROVIDER: PENALTY_CALCULATOR
### -------------------------------------------------------

### 2.1. Cek Denda Terlambat 3 Hari (3 x Rp 2.500 = Rp 7.500)
GET {{baseUrl}}/books/1/penalty-check?daysLate=3

### 2.2. Cek Denda Terlambat 10 Hari (10 x Rp 2.500 = Rp 25.000)
GET {{baseUrl}}/books/2/penalty-check?daysLate=10


### -------------------------------------------------------
### 3. PENGUJIAN OPERASI CRUD BUKU VIA SERVICE
### -------------------------------------------------------

### 3.1. Ambil Semua Buku
GET {{baseUrl}}/books

### 3.2. Tambah Buku Baru
POST {{baseUrl}}/books
Content-Type: application/json

{
  "title": "Clean Architecture: A Craftsman's Guide",
  "author": "Robert C. Martin",
  "isbn": "978-0134494166",
  "publishedYear": 2017,
  "rentalPrice": 25000
}

### 3.3. Pinjam Buku ID #1
PATCH {{baseUrl}}/books/1/borrow

### 3.4. Kembalikan Buku ID #1
PATCH {{baseUrl}}/books/1/return


### -------------------------------------------------------
### 4. PENGUJIAN OPERASI CRUD MEMBERS VIA SERVICE
### -------------------------------------------------------

### 4.1. Ambil Semua Member
GET {{baseUrl}}/members

### 4.2. Tambah Member Baru
POST {{baseUrl}}/members
Content-Type: application/json

{
  "fullName": "Dewi Sartika",
  "email": "dewi.sartika@example.com",
  "phoneNumber": "081299887766"
}
